---
import { formatProjectDate, hasDetailPage, type Project } from '../data/projects';

interface Props {
  project: Project;
  variant?: 'featured' | 'compact';
}

const { project, variant = 'compact' } = Astro.props;
const detailHref = hasDetailPage(project) ? `/projets/${project.slug}/` : null;
const titleHref = detailHref ?? project.url;
const isExternalTitle = !detailHref && Boolean(project.url);
const image = project.images[0];
const tags = variant === 'compact' ? project.tags.slice(0, 4) : project.tags;
---

<article class:list={['project-card', `project-card--${variant}`]} data-type={project.type}>
  <div class="project-thumb">
    {image ? (
      <img src={image} alt="" loading={variant === 'featured' ? 'eager' : 'lazy'} decoding="async" />
    ) : (
      <span class="project-thumb__placeholder" aria-hidden="true">{project.name}</span>
    )}
    {project.status === 'ongoing' && <span class="project-status">En cours</span>}
  </div>

  <div class="project-body">
    <p class="project-meta">
      <span>{project.type}</span>
      <span aria-hidden="true">·</span>
      <time datetime={project.startedAt}>{formatProjectDate(project)}</time>
    </p>

    <h3 class="project-title">
      {titleHref ? (
        <a
          href={titleHref}
          class="project-title-link"
          {...(isExternalTitle ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
        >
          {project.name}
        </a>
      ) : (
        project.name
      )}
    </h3>

    <p class="project-pitch">{project.pitch}</p>

    {variant === 'featured' && project.results.length > 0 && (
      <ul class="project-results" aria-label={`Résultats de ${project.name}`}>
        {project.results.map((line) => <li>{line}</li>)}
      </ul>
    )}

    {variant === 'featured' && project.role && (
      <p class="project-role"><strong>Mon rôle</strong> {project.role}</p>
    )}

    {tags.length > 0 && (
      <ul class="project-tags" aria-label={`Technologies de ${project.name}`}>
        {tags.map((tag) => <li>{tag}</li>)}
      </ul>
    )}

    <p class="project-links">
      {detailHref && (
        <a href={detailHref} class="project-link project-link--primary">
          {variant === 'featured' ? 'L’histoire du projet' : 'En savoir plus'}
          <span class="visually-hidden"> : {project.name}</span>
        </a>
      )}
      {project.url && (
        <a href={project.url} target="_blank" rel="noopener noreferrer" class="project-link project-link--external">
          Voir le projet<span class="visually-hidden"> {project.name} (nouvel onglet)</span>
        </a>
      )}
      {project.extensionUrl && (
        <a href={project.extensionUrl} target="_blank" rel="noopener noreferrer" class="project-link project-link--external">
          Extension Chrome<span class="visually-hidden"> {project.name} (nouvel onglet)</span>
        </a>
      )}
      {project.repoUrl && (
        <a href={project.repoUrl} target="_blank" rel="noopener noreferrer" class="project-link project-link--external">
          Code source<span class="visually-hidden"> de {project.name} (nouvel onglet)</span>
        </a>
      )}
    </p>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: grid;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: var(--shadow);
    transition: transform var(--transition), border-color var(--transition), box-shadow var(--transition);
  }

  .project-card[hidden] {
    display: none;
  }

  .project-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--accent) 66%, transparent);
    box-shadow: 0 18px 34px color-mix(in srgb, var(--accent) 11%, transparent);
  }

  .project-card--featured {
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
  }

  .project-thumb {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 22%, var(--surface)), color-mix(in srgb, var(--accent-2) 18%, var(--surface)));
  }

  .project-card--featured .project-thumb {
    aspect-ratio: auto;
    min-height: 100%;
    border-right: 1px solid color-mix(in srgb, var(--line) 60%, transparent);
  }

  .project-card--compact .project-thumb {
    border-bottom: 1px solid color-mix(in srgb, var(--line) 60%, transparent);
  }

  .project-thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    transition: transform 400ms ease;
  }

  .project-card:hover .project-thumb img {
    transform: scale(1.03);
  }

  .project-thumb__placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-heading);
    font-size: 1.6rem;
    color: color-mix(in srgb, var(--text) 55%, transparent);
  }

  .project-status {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    background: color-mix(in srgb, #111827 78%, transparent);
    color: #fff;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }

  .project-status::before {
    content: '';
    display: inline-block;
    width: 0.45rem;
    height: 0.45rem;
    margin-right: 0.4rem;
    border-radius: 50%;
    background: #34d399;
    vertical-align: 0.05em;
  }

  .project-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.25rem;
  }

  .project-card--featured .project-body {
    gap: 0.9rem;
    padding: 1.75rem;
  }

  .project-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    color: var(--muted);
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .project-title {
    margin: 0;
    line-height: 1.15;
  }

  .project-card--featured .project-title {
    font-size: clamp(1.7rem, 3vw, 2.2rem);
  }

  .project-title-link {
    color: inherit;
    text-decoration: none;
  }

  /* Toute la carte devient cliquable via le titre */
  .project-title-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .project-title-link:focus-visible {
    outline: none;
  }

  .project-card:has(.project-title-link:focus-visible) {
    outline: 3px solid var(--focus-ring);
    outline-offset: 3px;
  }

  .project-pitch {
    margin: 0;
    line-height: 1.55;
  }

  .project-card--featured .project-pitch {
    font-size: 1.08rem;
  }

  .project-results {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-results li {
    position: relative;
    padding-left: 1.6rem;
    line-height: 1.45;
    font-size: var(--text-sm);
  }

  .project-results li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0.05rem;
    display: grid;
    place-items: center;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 700;
  }

  .project-role {
    margin: 0;
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .project-role strong {
    display: block;
    color: var(--text);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .project-tags li {
    padding: 0.25rem 0.6rem;
    border: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .project-links {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    margin: auto 0 0;
    padding-top: 0.25rem;
  }

  .project-link {
    font-weight: 600;
    font-size: var(--text-sm);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--transition);
  }

  .project-link:hover {
    border-color: currentColor;
  }

  .project-link--primary::after {
    content: ' →';
  }

  .project-link--external::after {
    content: ' ↗';
    font-size: 0.9em;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .project-card--featured {
      grid-template-columns: 1fr;
    }

    .project-card--featured .project-thumb {
      aspect-ratio: 16 / 10;
      min-height: 0;
      border-right: 0;
      border-bottom: 1px solid color-mix(in srgb, var(--line) 60%, transparent);
    }

    .project-card--featured .project-body {
      padding: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-thumb img {
      transition: none;
    }

    .project-card:hover,
    .project-card:hover .project-thumb img {
      transform: none;
    }
  }
</style>
