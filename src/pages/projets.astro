---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { featuredProjects, otherProjects, projectTypes, projectsPage } from '../data/projects';

const { heroEyebrow, heroTitle, heroLead, stats, featuredTitle, sectionTitle, work } = projectsPage;
const others = [
  ...otherProjects.filter((p) => p.status === 'ongoing'),
  ...otherProjects.filter((p) => p.status === 'completed'),
];
---

<BaseLayout
  title="Projets | Stan Bouchet"
  description={heroLead || heroTitle}
  ogImage="/images/og/projets.jpg"
>
  <SiteHeader />

  <main id="main-content" class="container section universe universe--projects">
    <section class="hero section">
      <div class="hero-panel">
        <p class="eyebrow">{heroEyebrow}</p>
        <h1>{heroTitle}</h1>
        {heroLead && <p class="lead muted">{heroLead}</p>}
        {stats.length > 0 && (
          <dl class="hero-stats">
            {stats.map((stat) => (
              <div class="hero-stat">
                <dt>{stat.label}</dt>
                <dd>{stat.value}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>
    </section>

    {projectTypes.length > 1 && (
      <nav class="filter-bar" aria-label="Filtrer les projets par type">
        <button class="filter-btn is-active" data-filter="all" type="button" aria-pressed="true">Tous</button>
        {projectTypes.map((type) => (
          <button class="filter-btn" data-filter={type} type="button" aria-pressed="false">{type}</button>
        ))}
      </nav>
    )}
    <p class="filter-count" aria-live="polite" aria-atomic="true"></p>

    {featuredProjects.length > 0 && (
      <section class="section project-section" aria-labelledby="featured-title" data-project-section>
        <h2 id="featured-title">{featuredTitle}</h2>
        <div class="featured-list">
          {featuredProjects.map((project) => <ProjectCard project={project} variant="featured" />)}
        </div>
      </section>
    )}

    {work && (
      <section class:list={['section', 'work', { 'work--compact': work.stats.length === 0 }]} aria-labelledby="work-title">
        <div class="work-intro">
          <h2 id="work-title">{work.title}</h2>
          <p>{work.lead}</p>
          {work.linkUrl && work.linkLabel && <a class="work-link" href={work.linkUrl}>{work.linkLabel} →</a>}
        </div>
        {work.stats.length > 0 && (
          <dl class="work-stats">
            {work.stats.map((stat) => (
              <div>
                <dt>{stat.label}</dt>
                <dd>{stat.value}</dd>
              </div>
            ))}
          </dl>
        )}
        {work.highlights.length > 0 && (
          <ul class="work-highlights">
            {work.highlights.map((line) => <li>{line}</li>)}
          </ul>
        )}
      </section>
    )}

    {others.length > 0 && (
      <section class="section project-section" aria-labelledby="others-title" data-project-section>
        <h2 id="others-title">{sectionTitle}</h2>
        <div class="project-grid">
          {others.map((project) => <ProjectCard project={project} />)}
        </div>
      </section>
    )}

    <section class="section contact-cta" aria-labelledby="cta-title">
      <h2 id="cta-title">Un projet, une question, un coup de main ?</h2>
      <p>Je réponds à tous les messages, que ce soit pour un poste, une association ou un outil à construire.</p>
      <a class="cta-btn" href="/contact">Me contacter</a>
    </section>
  </main>

  <SiteFooter />
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const cards = document.querySelectorAll<HTMLElement>('.project-card');
  const sections = document.querySelectorAll<HTMLElement>('[data-project-section]');
  const countEl = document.querySelector<HTMLElement>('.filter-count');

  function applyFilter(filter: string) {
    let visible = 0;
    cards.forEach((card) => {
      const match = filter === 'all' || card.dataset.type === filter;
      card.hidden = !match;
      if (match) visible++;
    });
    sections.forEach((section) => {
      section.hidden = !section.querySelector('.project-card:not([hidden])');
    });
    if (countEl) {
      countEl.textContent =
        filter === 'all' ? '' : `${visible} projet${visible > 1 ? 's' : ''} affiché${visible > 1 ? 's' : ''}`;
    }
  }

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => {
        b.classList.toggle('is-active', b === btn);
        b.setAttribute('aria-pressed', String(b === btn));
      });
      applyFilter(btn.dataset.filter ?? 'all');
    });
  });
</script>

<style>
  .hero {
    display: block;
    min-height: auto;
    padding-top: 1rem;
  }

  .hero h1 {
    width: 100%;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1rem;
    margin: 1.75rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--line) 60%, transparent);
  }

  .hero-stat {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.2rem;
  }

  .hero-stat dd {
    margin: 0;
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4vw, 2.6rem);
    font-weight: 600;
    line-height: 1;
    color: var(--accent);
  }

  .hero-stat dt {
    color: var(--muted);
    font-size: var(--text-sm);
    line-height: 1.4;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.5rem;
  }

  .filter-btn {
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--muted);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 500;
    border-radius: 999px;
    padding: 0.45rem 0.9rem;
    cursor: pointer;
    transition: color var(--transition), background var(--transition), border-color var(--transition);
    white-space: nowrap;
  }

  .filter-btn:hover {
    color: var(--text);
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
  }

  .filter-btn.is-active {
    color: var(--accent-contrast);
    background: var(--accent);
    border-color: var(--accent);
  }

  .filter-count {
    margin: 0.6rem 0 0;
    color: var(--muted);
    font-size: var(--text-xs);
    min-height: 1.4em;
  }

  .project-section[hidden] {
    display: none;
  }

  .project-section h2 {
    margin: 0 0 1.1rem;
  }

  .featured-list {
    display: grid;
    gap: 1.5rem;
  }

  .project-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .work {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.5rem 2.5rem;
    padding: 2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--accent) 9%, var(--surface)), var(--surface));
  }

  .work--compact {
    grid-template-columns: 1fr;
  }

  .work--compact .work-intro p {
    max-width: 62ch;
  }

  .work-intro h2 {
    margin: 0 0 0.6rem;
  }

  .work-intro p {
    margin: 0 0 1rem;
    line-height: 1.6;
  }

  .work-link {
    font-weight: 600;
    text-decoration: none;
  }

  .work-link:hover {
    text-decoration: underline;
  }

  .work-stats {
    display: grid;
    gap: 1rem;
    margin: 0;
    align-content: start;
  }

  .work-stats div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.15rem;
  }

  .work-stats dd {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 600;
    line-height: 1;
    color: var(--accent);
  }

  .work-stats dt {
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .work-highlights {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 1.25rem 0 0;
    border-top: 1px solid color-mix(in srgb, var(--line) 60%, transparent);
    list-style: none;
  }

  .work-highlights li {
    position: relative;
    padding-left: 1.6rem;
    line-height: 1.5;
    font-size: var(--text-sm);
  }

  .work-highlights li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0.1rem;
    display: grid;
    place-items: center;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 700;
  }

  .contact-cta {
    text-align: center;
    padding: 2.5rem 1rem 1rem;
  }

  .contact-cta h2 {
    margin: 0 0 0.5rem;
  }

  .contact-cta p {
    margin: 0 auto 1.25rem;
    max-width: 46ch;
    color: var(--muted);
  }

  .cta-btn {
    display: inline-block;
    padding: 0.75rem 1.4rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--accent-contrast);
    font-weight: 600;
    text-decoration: none;
    transition: transform var(--transition), box-shadow var(--transition);
  }

  .cta-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 24px color-mix(in srgb, var(--accent) 25%, transparent);
  }

  @media (max-width: 1100px) {
    .project-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .project-grid,
    .work,
    .work-highlights {
      grid-template-columns: 1fr;
    }

    .work {
      padding: 1.25rem;
    }
  }
</style>
