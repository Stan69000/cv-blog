---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import siteConfig from '../../data/site.json';

export const prerender = true;

export async function getStaticPaths() {
  if (!siteConfig.blogPublished) return [];

  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post }
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = new Intl.DateTimeFormat('fr-FR', { dateStyle: 'long' });
const publishedTime = post.data.pubDate.toISOString();
const modifiedTime = post.data.updatedDate ? post.data.updatedDate.toISOString() : undefined;
---

<BaseLayout
  title={`${post.data.title} | Blog`}
  description={post.data.description}
  ogImage={post.data.heroImage}
  ogType="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  articleTags={post.data.tags}
>
  <SiteHeader />
  <main id="main-content" class="container section article-page">
    <div class="article-shell">
      <p class="article-back"><a href="/blog">← Tous les articles</a></p>
      <header class="article-header">
        <p class="article-meta">Publié le {fmt.format(post.data.pubDate)}</p>
        <h1>{post.data.title}</h1>
        <p class="article-lead">{post.data.description}</p>

        {post.data.tags.length > 0 && (
          <ul class="tags" aria-label="Étiquettes">
            {post.data.tags.map((tag: string) => (
              <li>{tag}</li>
            ))}
          </ul>
        )}

        {post.data.heroImage && (
          <img class="article-cover" src={post.data.heroImage} alt="" loading="eager" />
        )}
      </header>

      <article class="prose">
        <Content />
      </article>

      <footer class="article-footer">
        <a href="/blog">← Retour au blog</a>
      </footer>
    </div>
  </main>
  <SiteFooter />
</BaseLayout>

<style>
  .article-page {
    overflow: visible;
    padding-block: clamp(1.5rem, 4vw, 3.5rem) 5rem;
  }

  .article-shell {
    max-width: 920px;
    margin-inline: auto;
  }

  .article-back {
    margin-bottom: 1.25rem;
    font-size: var(--text-sm);
  }

  .article-back a,
  .article-footer a {
    color: var(--muted);
    font-weight: 600;
    text-decoration: none;
  }

  .article-back a:hover,
  .article-footer a:hover {
    color: var(--accent);
  }

  .article-header {
    border-block: 1px solid var(--line);
    padding-block: clamp(2rem, 5vw, 4rem);
  }

  .article-meta {
    color: var(--accent);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .article-header h1 {
    max-width: 17ch;
    margin-top: 1rem;
    font-size: clamp(2.75rem, 7vw, 5.6rem);
    line-height: 0.96;
  }

  .article-lead {
    max-width: 64ch;
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.7;
  }

  .article-cover {
    display: block;
    width: 100%;
    max-height: 520px;
    margin-top: 2rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    object-fit: cover;
  }

  .prose {
    display: block;
    max-width: 70ch;
    margin: clamp(2.5rem, 6vw, 5rem) auto 0;
    font-size: clamp(1.0625rem, 1.4vw, 1.16rem);
    line-height: 1.9;
  }

  .prose :global(p + p) {
    margin-top: 1.35em;
  }

  .prose :global(h2) {
    margin: 2.8em 0 0.8em;
    padding-top: 0.75em;
    border-top: 1px solid var(--line);
    color: var(--text);
    font-size: clamp(1.9rem, 4vw, 2.7rem);
    line-height: 1.08;
  }

  .prose :global(h3) {
    margin: 2.2em 0 0.7em;
    font-size: clamp(1.4rem, 3vw, 1.8rem);
  }

  .prose :global(h2 + p),
  .prose :global(h3 + p) {
    margin-top: 0;
  }

  .prose :global(blockquote) {
    margin: 2rem 0;
    padding: 0.25rem 0 0.25rem 1.5rem;
    border-left: 3px solid var(--accent);
    color: var(--muted);
    font-size: 1.1em;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 1.4rem 0;
    padding-left: 1.5rem;
  }

  .prose :global(li + li) {
    margin-top: 0.55rem;
  }

  .article-footer {
    max-width: 70ch;
    margin: 4rem auto 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 640px) {
    .article-page {
      padding-inline: 1rem;
    }

    .article-header h1 {
      font-size: clamp(2.5rem, 14vw, 4rem);
    }
  }
</style>
